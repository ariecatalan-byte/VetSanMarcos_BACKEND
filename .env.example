# Copia este archivo a ".env" (que está en .gitignore) y completa los valores reales.
# Spring Boot lo lee automáticamente al arrancar desde la carpeta del backend.

# --- Base de datos (MySQL por defecto) ---
DB_URL=jdbc:mysql://localhost:3306/vetsanmarcos?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=cambia_esta_clave

# --- JWT ---
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=pega_aqui_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
# Vigencia del access token (ms) y del refresh token (días)
JWT_ACCESS_MS=900000
JWT_REFRESH_DAYS=7

# --- CORS: orígenes permitidos del frontend (separados por coma) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Datos de prueba (true = carga usuarios, productos y compras de demo si la BD está vacía) ---
SEED_ENABLED=true
